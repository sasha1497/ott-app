# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
BASE_URL=http://localhost:3000
CORS_ORIGIN=*

# PostgreSQL
# Matches docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ott_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20

# JWT
# Replace these in production with long random secrets.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Password Hashing
BCRYPT_SALT_ROUNDS=10

# Uploads
UPLOAD_DIR=uploads
MAX_VIDEO_SIZE_MB=2048
MAX_IMAGE_SIZE_MB=5

# SMTP / Email
# Leave empty for local testing if you do not want real emails to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OTT Platform <no-reply@example.com>

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
